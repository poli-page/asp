<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK of this package's minor: [0.13.0,0.14.0) is >= 0.13.0 and < 0.14, so restore picks
         0.13.0 and the .nupkg declares the same range. The Release workflow checks it against the tag
         (scripts/check-release-versions.sh). -->
    <PackageVersion Include="PoliPage" Version="[0.13.0,0.14.0)" />

    <!-- Analyzers (match sdk-csharp set) -->
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.317" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />

    <!-- Build-time only -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.303" />
    <!-- 10.0.14 matches the M.E.* family the SDK transitively brings in via M.E.Http;
         a lower pin causes NU1605 (downgrade). Keep aligned with whatever
         floor sdk-csharp's Directory.Packages.props uses for the rest of M.E.*. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />

    <!-- Test dependencies -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />

    <!-- Per-TFM testing host pins — Mvc.Testing must match the runtime ASP.NET Core major. -->
    <PackageVersion Condition="'$(TargetFramework)' == 'net8.0'"  Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.33" />
    <PackageVersion Condition="'$(TargetFramework)' == 'net10.0'" Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />

    <!-- HealthChecks integration deferred to a later release — see docs/sdk-surface-audit-2026-06-01.md §0.3. -->
  </ItemGroup>
</Project>

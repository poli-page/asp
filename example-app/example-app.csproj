<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Same TargetFrameworks as the library (net8.0;net10.0, from Directory.Build.props): the
         contract tests load this app in-process on both, so each CI leg checks it on its own
         runtime. `dotnet run` needs `-f net10.0` (or net8.0) to pick one. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PoliPage.AspNetCore.ExampleApp</RootNamespace>
    <AssemblyName>PoliPage.AspNetCore.ExampleApp</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      Demo / sample code, not a library. Turn off the parent's library-grade gates so this
      project doesn't impose XML doc requirements and AOT analyzer overhead on demo helpers.
    -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;IL2026;IL3050</NoWarn>
    <IsAotCompatible>false</IsAotCompatible>
    <UserSecretsId>polipage-aspnetcore-example-app</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\PoliPage.AspNetCore\PoliPage.AspNetCore.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net8.0;net10.0 from Directory.Build.props, like example-app: each CI leg runs the
         contract tests against the example app on its own runtime. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591;CA1707;IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PoliPage.AspNetCore/PoliPage.AspNetCore.csproj" />
    <ProjectReference Include="../../example-app/example-app.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../PoliPage.AspNetCore.Tests/Fixtures/TestKeys.cs" Link="Fixtures/TestKeys.cs" />
    <!-- The library's own key grammar, so the sandbox-key check cannot drift from it. -->
    <Compile Include="../../src/PoliPage.AspNetCore/Internal/ApiKeyFormat.cs" Link="Internal/ApiKeyFormat.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API contract skip list (Contract/ContractFile.cs reads it next to the tests). -->
    <None Include="../contract-skip.json" Link="contract-skip.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
